{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|Read",
        "hooks": [{ "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/skills/skill-blueprint/scripts/log_event.py\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [{ "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/skills/skill-blueprint/scripts/log_event.py\"" }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/skills/skill-blueprint/scripts/log_event.py\"" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/skills/skill-blueprint/scripts/log_event.py\"" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/skills/skill-blueprint/scripts/log_event.py\"" }] }
    ]
  }
}
